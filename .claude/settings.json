{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(rm *)",
      "Read(./Remedy.xcodeproj/xcuserdata/**)",
      "Read(./Remedy.xcodeproj/project.xcworkspace/xcuserdata/**)",
      "Read(./DemoVideo/**)",
      "Read(./Backup-before-comments/**)"
    ]
  }
}
